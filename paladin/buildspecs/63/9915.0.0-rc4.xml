fail_count="0"/><pending_commit branch="master" change_id="I8e8f630b551b948020325bc670a6d00c60aeb2e2" commit="ab3b8f346c21b2712ad7502b9f9f71ecbd6abcc1" commit_message="Instalog: Refactor output_bigquery plugin by using google-cloud-python  Upgrade output_bigquery plugin from google-api-python-client to google-cloud-python. To avoid running out of memory, we use json file instead of StringIO.  BUG=b:64501030, b:38189459 TEST=manually test on local device  Change-Id: I8e8f630b551b948020325bc670a6d00c60aeb2e2 Reviewed-on: https://chromium-review.googlesource.com/618826 Commit-Ready: Chun-Tsen Kuo &lt;chuntsen@chromium.org&gt; Tested-by: Chun-Tsen Kuo &lt;chuntsen@chromium.org&gt; Reviewed-by: Joel Kitching &lt;kitching@chromium.org&gt; " fail_count="0" gerrit_number="618826" owner_email="chuntsen@chromium.org" pass_count="0" patch_number="17" project="chromiumos/platform/factory" project_url="https://chromium-review.googlesource.com/chromiumos/platform/factory" ref="refs/changes/26/618826/17" remote="cros" total_fail_count="0"/><pending_commit branch="master" change_id="I6f5daeedf1f7f852b38ea963e5d649a8967fab82" commit="4e321276da1bc0ddf14d97ad7a85cbb30c76139d" commit_message="CHROME_LKGM: allow trailing newline in file  Many editors automatically add a trailing newline at the end of files. This makes manually editing CHROME_LKGM hazardous, since cros chrome-sdk would then fail with the following error:     ToGNString        raise GNException(&quot;Trying to print a string with a newline in it.&quot;)  Strip trailing newline/whitespaces characters in CHROME_LKGM to cover that case.  BUG=chromium:762146 TEST=tried cros chrome-sdk with a CHROME_LKGM ending by a newline, confirmed it worked.  Change-Id: I6f5daeedf1f7f852b38ea963e5d649a8967fab82 Reviewed-on: https://chromium-review.googlesource.com/651612 Commit-Ready: Alexandre Courbot &lt;acourbot@chromium.org&gt; Tested-by: Alexandre Courbot &lt;acourbot@chromium.org&gt; Reviewed-by: Achuith Bhandarkar &lt;achuith@chromium.org&gt; Reviewed-by: Steven Bennetts &lt;stevenjb@chromium.org&gt; " fail_count="0" gerrit_number="651612" owner_email="acourbot@chromium.org" pass_count="0" patch_number="4" project="chromiumos/chromite" project_url="https://chromium-review.googlesource.com/chromiumos/chromite" ref="refs/changes/12/651612/4" remote="cros" total_fail_count="0"/><lkgm version="9915.0.0-rc3"/></manifest>