e_id="I8f081c6779cf9a5c38de0e11e59524d074738419" commit="ee6529e72e193b4ca35a2d790172b5d76c3cf1b2" commit_message="login: Fix calculation of management state  Use management_mode to determine whether device is managed and only fall back to DM token in case the former doesn't exist.  This is required to properly support Chromad, but should have no effect on other types of management (including local ownership).  BUG=chromium:722799 TEST=unit test added  Change-Id: I8f081c6779cf9a5c38de0e11e59524d074738419 Reviewed-on: https://chromium-review.googlesource.com/518015 Commit-Ready: Thiemo Nagel &lt;tnagel@chromium.org&gt; Tested-by: Thiemo Nagel &lt;tnagel@chromium.org&gt; Reviewed-by: Dan Erat &lt;derat@chromium.org&gt; " fail_count="0" gerrit_number="518015" owner_email="tnagel@chromium.org" pass_count="0" patch_number="1" project="chromiumos/platform2" project_url="https://chromium-review.googlesource.com/chromiumos/platform2" ref="refs/changes/15/518015/1" remote="cros" total_fail_count="0"/><pending_commit branch="master" change_id="I0e81a7eafeaab84be5fbb8648df77f490921615b" commit="f840aca8b12e107384d2d62a04a5c9348330ed11" commit_message="authpolicy: Fix failing authpolicy_flags tests in release  DCHECK'ed code that should be enabled in release builds.  BUG=chromium:726757 TEST=cbuildbot --remote -g 518105 asuka-release  Change-Id: I0e81a7eafeaab84be5fbb8648df77f490921615b Reviewed-on: https://chromium-review.googlesource.com/518105 Commit-Ready: Lutz Justen &lt;ljusten@chromium.org&gt; Tested-by: Lutz Justen &lt;ljusten@chromium.org&gt; Reviewed-by: Thiemo Nagel &lt;tnagel@chromium.org&gt; " fail_count="0" gerrit_number="518105" owner_email="ljusten@chromium.org" pass_count="0" patch_number="3" project="chromiumos/platform2" project_url="https://chromium-review.googlesource.com/chromiumos/platform2" ref="refs/changes/05/518105/3" remote="cros" total_fail_count="0"/><pending_commit branch="master" change_id="I2717d4d8481d18a0793331d361bc0de0d9aaaaad" commit="f92b62cdfb061d01efd8889854126a75987f2c59" commit_message="Removes recovery_count from vpd in factory reset.  BUG=chromium:717788 TEST=Performed factory reset and made sure recovery_count is removed.  Change-Id: I2717d4d8481d18a0793331d361bc0de0d9aaaaad Reviewed-on: https://chromium-review.googlesource.com/509889 Commit-Ready: Amin Hassani &lt;ahassani@chromium.org&gt; Tested-by: Amin Hassani &lt;ahassani@chromium.org&gt; Reviewed-by: Hung-Te Lin &lt;hungte@chromium.org&gt; " fail_count="0" gerrit_number="509889" owner_email="ahassani@chromium.org" pass_count="0" patch_number="3" project="chromiumos/platform/factory" project_url="https://chromium-review.googlesource.com/chromiumos/platform/factory" ref="refs/changes/89/509889/3" remote="cros" total_fail_count="0"/><pending_commit branch="master" change_id="I1b04d0e38a233b146aeace118baa209bb4fcda0d" commit="f43c8706be35ab1aa97c8cba2cadf274cdffa7b8" commit_message="Set or increase recovery_count  recovery_count is an integer flag in RW_VPD and is increased by one everytime the device is recovered. The initial value is 1 if it doesn't exist in RW_VPD.  BUG=chromium:717788 TEST=Deployed on a device and made sure flags are set and increased properly.  Change-Id: I1b04d0e38a233b146aeace118baa209bb4fcda0d Reviewed-on: https://chromium-review.googlesource.com/509988 Commit-Ready: Amin Hassani &lt;ahassani@chromium.org&gt; Tested-by: Amin Hassani &lt;ahassani@chromium.org&gt; Reviewed-by: Hung-Te Lin &lt;hungte@chromium.org&gt; Reviewed-by: Mike Frysinger &lt;vapier@chromium.org&gt; " fail_count="0" gerrit_number="509988" owner_email="ahassani@chromium.org" pass_count="0" patch_number="2" project="chromiumos/platform/initramfs" project_url="https://chromium-review.googlesource.com/chromiumos/platform/initramfs" ref="refs/changes/88/509988/2" remote="cros" total_fail_count="0"/><pending_commit branch="master" change_id="I0b748e34f311f04dda33287f4e85ce4bf6970e27" commit="b1b93b8944934ca9a72dd75f31b317c0bdaafef7" commit_message="debugd: don't close bound fds in SandboxedProcess  dbus::FileDescriptor contains a base::ScopedFD, which fails a CHECK on destruction if the close call fails with EBADF. This means you can't double-close a ScopedFD. This is a problem if it's stored in a SandboxedProcess that doesn't outlive the dbus::FileDescriptor because the ProcessImpl closes all FDs in its pipe map on destruction.  Unfortunately, the dbus::FileDescriptors are passed as const &amp; from the D-Bus bindings, so TakeValue() is not an option without a const cast. Additionally, if BindFd was supposed to take ownership of the FD its API should take a ScopedFD instead to signal this.  BUG=chromium:722501 TEST=use SystraceTool, PerfTool and ensure they don't crash   debugd via the double-close CHECK; also watch the FD table   and make sure no FDs are leaked  Change-Id: I0b748e34f311f04dda33287f4e85ce4bf6970e27 Reviewed-on: https://chromium-review.googlesource.com/514522 Commit-Ready: Eric Caruso &lt;ejcaruso@chromium.org&gt; Tested-by: Eric Caruso &lt;ejcaruso@chromium.org&gt; Reviewed-by: Ben Chan &lt;benchan@chromium.org&gt; " fail_count="1" gerrit_number="514522" owner_email="ejcaruso@chromium.org" pass_count="0" patch_number="4" project="chromiumos/platform2" project_url="https://chromium-review.googlesource.com/chromiumos/platform2" ref="refs/changes/22/514522/4" remote="cros" total_fail_count="1"/><pending_commit branch="master" change_id="I5da1c664f110f11e8db1d1a7a9d6f72ec1037ad9" commit="3f8c8623b9ae09174c6926ca73b55a2508228c05" commit_message="Make chell-nowithdebug-paladin important  BUG=chromium:725931 TEST=None  Change-Id: I5da1c664f110f11e8db1d1a7a9d6f72ec1037ad9 Reviewed-on: https://chromium-review.googlesource.com/513615 Commit-Ready: Bernie Thompson &lt;bhthompson@chromium.org&gt; Tested-by: Bernie Thompson &lt;bhthompson@chromium.org&gt; Reviewed-by: Mike Frysinger &lt;vapier@chromium.org&gt; " fail_count="0" gerrit_number="513615" owner_email="bhthompson@chromium.org" pass_count="0" patch_n