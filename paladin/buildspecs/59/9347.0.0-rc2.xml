miumos/third_party/autotest" ref="refs/changes/03/448703/2" remote="cros" total_fail_count="1"/><pending_commit branch="master" change_id="If7165f455be49ef904c4c53dc7bae66d952e97cf" commit="ef59295ad27e35769383ef36ae4b8b9f0bf23dd1" commit_message="installer: Move legacy_offset_size_export  Move legacy_offset_size_export to chromeos-install. It is the only place where this function is called, and it seems like it deprecated, so we should remove it from a common file where it may be used more broadly.  BUG=b:35045101 TEST=`chromeos-install`  Change-Id: If7165f455be49ef904c4c53dc7bae66d952e97cf Reviewed-on: https://chromium-review.googlesource.com/444913 Commit-Ready: Ian Coolidge &lt;icoolidge@google.com&gt; Tested-by: Joshua Emele &lt;jemele@google.com&gt; Reviewed-by: Mike Frysinger &lt;vapier@chromium.org&gt; " fail_count="0" gerrit_number="444913" owner_email="icoolidge@google.com" pass_count="0" patch_number="3" project="chromiumos/platform2" project_url="https://chromium-review.googlesource.com/chromiumos/platform2" ref="refs/changes/13/444913/3" remote="cros" total_fail_count="0"/><lkgm version="9346.0.0-rc3"/></manifest>