scaling_governor  echo nop &gt; current_tracer &amp;&amp; sleep 0.2 &amp;&amp; echo function_graph &gt; current_tracer  echo funcgraph-abstime &gt; trace_options  echo performance &gt; /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor  cat trace  ===&gt; Without regcache (regulator_get_voltage sometimes takes &gt; 1ms):   648.844095 |   1)               |  mtk_cpufreq_set_target() {   648.844121 |   1) ! 1935.539 us |    regulator_get_voltage();   648.846084 |   1) ! 571.923 us  |    regulator_get_voltage();   648.846672 |   1) + 22.692 us   |    regulator_get_voltage();   648.846703 |   1) + 15.615 us   |    regulator_get_voltage();   648.846727 |   1) ! 4137.923 us |    regulator_get_voltage();   648.850887 |   1) + 73.000 us   |    regulator_set_voltage();   648.850971 |   1) ! 1734.462 us |    regulator_set_voltage();   648.852723 |   1) + 22.692 us   |    regulator_get_voltage();   648.852755 |   1) ! 372.461 us  |    regulator_get_voltage();   648.853139 |   1) + 61.077 us   |    regulator_set_voltage();   648.853209 |   1) ! 1716.000 us |    regulator_set_voltage();   648.854941 |   1) + 21.770 us   |    regulator_get_voltage();   648.854972 |   1) ! 486.769 us  |    regulator_get_voltage();   648.855470 |   1) + 56.538 us   |    regulator_set_voltage();   648.855536 |   1) ! 1965.539 us |    regulator_set_voltage();   648.857597 |   1) ! 13490.77 us |  }  ===&gt; With regcache (regulator_get_voltage is consistently ~15us):   120.327756 |   1)               |  mtk_cpufreq_set_target() {   120.327784 |   1) + 25.231 us   |    regulator_get_voltage();   120.327825 |   1) + 13.769 us   |    regulator_get_voltage();   120.327847 |   1) + 23.077 us   |    regulator_get_voltage();   120.327878 |   1) + 15.615 us   |    regulator_get_voltage();   120.327902 |   1) + 13.384 us   |    regulator_get_voltage();   120.327924 |   1) + 65.231 us   |    regulator_set_voltage();   120.327998 |   1) ! 2937.846 us |    regulator_set_voltage();   120.330961 |   1) + 29.462 