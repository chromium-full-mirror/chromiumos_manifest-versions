<pending_commit branch="master" change_id="Ifceb9f9e8a86c70941f08240421076a8d9c12200" commit="65688c3b8b8c48ad85ea7ff8eecad46f0772046e" commit_message="UCM: Disable software volume for Jabra SPEAK 810  Jabra SPEAK 810 speaker has only 30 dB range, but we do not want to use software volume on it.  BUG=chromium:546973 TEST=check the speaker does not use software volume  Signed-off-by: Cheng-Yi Chiang &lt;cychiang@chromium.org&gt; Change-Id: Ifceb9f9e8a86c70941f08240421076a8d9c12200 Reviewed-on: https://chromium-review.googlesource.com/308342 Reviewed-by: Dylan Reid &lt;dgreid@chromium.org&gt; " fail_count="0" gerrit_number="308342" owner_email="cychiang@chromium.org" pass_count="0" patch_number="1" project="chromiumos/third_party/adhd" project_url="https://chromium-review.googlesource.com/chromiumos/third_party/adhd" ref="refs/changes/42/308342/1" remote="cros" total_fail_count="0"/><pending_commit branch="master" change_id="Id5cd7c1548da55eb3e179e7eaa4058d7f14031e5" commit="0a45266e93417cf17378b6c7cabcc1db1fe61edc" commit_message="CRAS-CONFIG: Add volume curve for Jabra SPEAK 810  The volume range is 30 dB, use the simple curve.  BUG=chromium:546973 TEST=Check LED as volume grows.  Signed-off-by: Cheng-Yi Chiang &lt;cychiang@chromium.org&gt; Change-Id: Id5cd7c1548da55eb3e179e7eaa4058d7f14031e5 Reviewed-on: https://chromium-review.googlesource.com/308343 Reviewed-by: Mats Nilsson &lt;mnilsson@chromium.org&gt; Reviewed-by: Dylan Reid &lt;dgreid@chromium.org&gt; " fail_count="0" gerrit_number="308343" owner_email="cychiang@chromium.org" pass_count="0" patch_number="1" project="chromiumos/third_party/adhd" project_url="https://chromium-review.googlesource.com/chromiumos/third_party/adhd" ref="refs/changes/43/308343/1" remote="cros" total_fail_count="0"/><pending_commit branch="master" change_id="I4cb0cef5d30ed3179288d30f498ac63730efb26e" commit="1243c45ab75c7e3e03d0e97544ca08156dd6e7cc" commit_message="UPSTREAM: profiles/deviceinfo: rewrite deviceinfo profile  This patch